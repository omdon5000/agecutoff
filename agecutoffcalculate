<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Advanced Age Calculator</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
}

body {
    height: 100vh;
    background: linear-gradient(135deg, #0f172a, #1e3a8a, #9333ea);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
}

.container {
    width: 380px;
    padding: 25px;
    border-radius: 20px;
    backdrop-filter: blur(20px);
    background: rgba(255,255,255,0.08);
    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
}

h2 {
    text-align: center;
    margin-bottom: 20px;
    font-weight: 600;
}

label {
    font-size: 14px;
    margin-top: 10px;
    display: block;
}

input, select {
    width: 100%;
    padding: 10px;
    margin-top: 6px;
    border-radius: 10px;
    border: none;
    outline: none;
    background: rgba(255,255,255,0.15);
    color: white;
}

button {
    width: 100%;
    margin-top: 15px;
    padding: 12px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(90deg, #22c55e, #4ade80);
    color: black;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    transform: scale(1.05);
}

.result {
    margin-top: 20px;
    padding: 15px;
    border-radius: 12px;
    background: rgba(0,0,0,0.4);
    text-align: center;
}

.age {
    font-size: 20px;
    margin-bottom: 10px;
}

.status {
    font-size: 18px;
    font-weight: bold;
}

.valid { color: #22c55e; }
.invalid { color: #ef4444; }

</style>
</head>

<body>

<div class="container">
    <h2>Age Calculator</h2>

    <label>Date of Birth</label>
    <input type="date" id="dob">

    <label>Cutoff Date</label>
    <input type="date" id="cutoff">

    <label>Category</label>
    <select id="category">
        <option value="GEN">General</option>
        <option value="OBC">OBC (+3)</option>
        <option value="SC">SC (+5)</option>
        <option value="ST">ST (+5)</option>
        <option value="PWD">PWD (+10)</option>
    </select>

    <button onclick="calculate()">Check Eligibility</button>

    <div class="result" id="result">Enter details to check eligibility</div>
</div>

<script>
function calculateAge(dob, cutoff) {
    let birth = new Date(dob);
    let cut = new Date(cutoff);

    let years = cut.getFullYear() - birth.getFullYear();
    let months = cut.getMonth() - birth.getMonth();
    let days = cut.getDate() - birth.getDate();

    if (days < 0) {
        months--;
        let prevMonth = new Date(cut.getFullYear(), cut.getMonth(), 0);
        days += prevMonth.getDate();
    }

    if (months < 0) {
        years--;
        months += 12;
    }

    return { years, months, days };
}

function getRelaxation(category) {
    switch(category) {
        case "OBC": return 3;
        case "SC":
        case "ST": return 5;
        case "PWD": return 10;
        default: return 0;
    }
}

function calculate() {
    let dob = document.getElementById("dob").value;
    let cutoff = document.getElementById("cutoff").value;
    let category = document.getElementById("category").value;

    if (!dob || !cutoff) {
        alert("Please fill all fields");
        return;
    }

    let age = calculateAge(dob, cutoff);

    let minAge = 18;
    let maxAge = 45 + getRelaxation(category);

    let statusText = "";
    let statusClass = "";

    if (age.years < minAge) {
        statusText = "Underage ❌";
        statusClass = "invalid";
    } else if (age.years > maxAge) {
        statusText = "Overage ❌";
        statusClass = "invalid";
    } else {
        statusText = "Eligible ✅";
        statusClass = "valid";
    }

    document.getElementById("result").innerHTML = `
        <div class="age">${age.years}Y ${age.months}M ${age.days}D</div>
        <div class="status ${statusClass}">${statusText}</div>
        <small>Max Age Allowed: ${maxAge} Years</small>
    `;
}
</script>

</body>
</html>
